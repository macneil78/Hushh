// Shared build settings. Personal values go in Secrets.xcconfig, which git ignores.

PRODUCT_NAME = Hushh
// Kept from the app's first name: macOS ties the sandbox data (and your login) to it.
PRODUCT_BUNDLE_IDENTIFIER = com.macneil.Hush
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1
MACOSX_DEPLOYMENT_TARGET = 26.0

// "Sign to Run Locally" until Secrets.xcconfig names your team.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

// The hardened runtime stops other processes from injecting code (DYLD_INSERT_LIBRARIES) or
// attaching a debugger, which would get the database key and the Telegram session. A "Sign to
// Run Locally" build has no team, so the entitlement com.apple.security.cs.disable-library-validation
// (project.yml) lets it load its own embedded frameworks.
ENABLE_HARDENED_RUNTIME = YES
// Xcode adds get-task-allow (a debugger may attach) to every build it signs. Debug keeps it for
// Xcode's debugger; Release, the build scripts/install.sh installs, must not have it.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO

HUSH_API_ID =
HUSH_API_HASH =

#include? "Secrets.xcconfig"
