// Shared build settings. Personal values go in Secrets.xcconfig, which git ignores.

PRODUCT_NAME = Hushh
// Kept from the app's first name: macOS ties the sandbox data (and your login) to it.
PRODUCT_BUNDLE_IDENTIFIER = com.macneil.Hush
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1
MACOSX_DEPLOYMENT_TARGET = 26.0

// "Sign to Run Locally" until Secrets.xcconfig names your team.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

// The hardened runtime only loads frameworks signed by the app's own team. A "Sign to Run Locally"
// build has no team, so it would refuse to launch with Lottie embedded. Secrets.xcconfig turns
// it on together with your team.
ENABLE_HARDENED_RUNTIME = NO

HUSH_API_ID =
HUSH_API_HASH =

#include? "Secrets.xcconfig"
