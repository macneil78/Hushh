// Copy this file to Secrets.xcconfig (git ignores it) and fill it in.

// From my.telegram.org → API development tools. Keep them private: they belong to your
// Telegram account.
HUSH_API_ID =
HUSH_API_HASH =

// Optional: sign with your Apple ID's Personal Team (Xcode → Settings → Accounts), so the
// keychain stops asking for permission after each rebuild. A team also allows the hardened
// runtime. Bundle identifiers are unique per team, so pick your own.
// DEVELOPMENT_TEAM = ABCDE12345
// CODE_SIGN_IDENTITY = Apple Development
// ENABLE_HARDENED_RUNTIME = YES
// PRODUCT_BUNDLE_IDENTIFIER = com.example.Hushh
