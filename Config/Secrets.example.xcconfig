// Copy this file to Secrets.xcconfig (git ignores it) and fill it in.

// From my.telegram.org → API development tools. Keep them private: they belong to your
// Telegram account.
HUSH_API_ID =
HUSH_API_HASH =

// HUSH_API_ID is digits only, HUSH_API_HASH the 32 letters and digits (0-9, a-f) of the hash.
// No quotes, no spaces.

// Optional: sign with your Apple ID's Personal Team (Xcode → Settings → Accounts), so the
// keychain stops asking for permission after each rebuild. Bundle identifiers are unique per
// team, so pick your own.
// DEVELOPMENT_TEAM = ABCDE12345
// CODE_SIGN_IDENTITY = Apple Development
// PRODUCT_BUNDLE_IDENTIFIER = com.example.Hushh
